rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isAdmin()
        && (!('assignedFacilityIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedFacilityIds.size() == 0);
    }

    function isFacilityAdmin(facilityId) {
      return isSuperAdmin()
        || (isAdmin()
            && facilityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedFacilityIds);
    }

    function bookingProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function bookingAfter(bookingId) {
      return getAfter(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function availabilityAfter(bookingId) {
      return getAfter(/databases/$(database)/documents/availability/$(bookingId));
    }

    function requestAlertAfter(bookingId) {
      return getAfter(/databases/$(database)/documents/requestAlerts/$(bookingId));
    }

    function scheduleDayAfter(facilityId, date) {
      return getAfter(/databases/$(database)/documents/scheduleDays/$(facilityId + '__' + date));
    }

    function schoolCalendarAllows(date) {
      let calendarPath = /databases/$(database)/documents/schoolCalendar/current;
      return date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && exists(calendarPath)
        && date >= get(calendarPath).data.startDate
        && date <= get(calendarPath).data.endDate
        && !(date in get(calendarPath).data.closedDates);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow create: if (isSelf(uid) && request.resource.data.role == 'student')
                    || (isSuperAdmin() && request.resource.data.role == 'admin'
                        && request.resource.data.assignedFacilityIds is list
                        && request.resource.data.assignedFacilityIds.size() > 0);
      allow update: if isSuperAdmin()
                    || (isSelf(uid)
                        && request.resource.data.role == resource.data.role
                        && (request.resource.data.get('emailOtpVerified', false)
                            == resource.data.get('emailOtpVerified', false)
                            || (request.resource.data.get('emailOtpVerified', false) == true
                                && request.auth.token.email_verified == true))
                        && (!('verificationRequired' in resource.data)
                            || resource.data.verificationRequired != true
                            || request.resource.data.verificationRequired == true)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['fullName', 'phone', 'grade', 'section', 'idPhotoUrl', 'verificationRequired', 'emailOtpVerified']));
      allow delete: if isSuperAdmin();
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.capacity is string;
      allow delete: if isSuperAdmin();
    }

    match /schoolCalendar/{calendarId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin()
        && calendarId == 'current'
        && request.resource.data.schoolYearLabel is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.closedDates is list
        && request.resource.data.closedDates.size() <= 366
        && request.resource.data.closedReasons is map
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'schoolYearLabel', 'startDate', 'endDate', 'closedDates',
          'closedReasons', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if false;
    }

    // Reservation details are private. Students can only read their own records.
    match /bookings/{bookingId} {
      allow read: if isFacilityAdmin(resource.data.facilityId) || (isSignedIn() && resource.data.userId == request.auth.uid);

      // A booking and its minimal public schedule projection must be written
      // together, so the calendar never needs access to personal details.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && bookingProfile().data.grade == request.resource.data.grade
                    && bookingProfile().data.section == request.resource.data.section
                    && bookingProfile().data.idPhotoUrl == request.resource.data.idPhotoUrl
                    && request.resource.data.idPhotoUrl is string
                    && exists(/databases/$(database)/documents/idPhotos/$(request.resource.data.idPhotoUrl))
                    && get(/databases/$(database)/documents/idPhotos/$(request.resource.data.idPhotoUrl)).data.ownerId == request.auth.uid
                    && (request.auth.token.email_verified == true
                        || bookingProfile().data.emailOtpVerified == true)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.startAt is timestamp
                    && request.resource.data.startAt > request.time
                    && request.resource.data.startAt <= request.time + duration.value(60, 'd')
                    && (request.resource.data.startAt + duration.value(8, 'h')).dayOfWeek() <= 5
                    && schoolCalendarAllows(request.resource.data.date)
                    && existsAfter(/databases/$(database)/documents/availability/$(bookingId))
                    && existsAfter(/databases/$(database)/documents/requestAlerts/$(bookingId))
                    && requestAlertAfter(bookingId).data.userId == request.auth.uid
                    && requestAlertAfter(bookingId).data.facilityId == request.resource.data.facilityId
                    && requestAlertAfter(bookingId).data.date == request.resource.data.date
                    && availabilityAfter(bookingId).data.facilityId == request.resource.data.facilityId
                    && availabilityAfter(bookingId).data.date == request.resource.data.date
                    && availabilityAfter(bookingId).data.startTime == request.resource.data.startTime
                    && availabilityAfter(bookingId).data.endTime == request.resource.data.endTime
                    && availabilityAfter(bookingId).data.status == request.resource.data.status
                    && existsAfter(/databases/$(database)/documents/scheduleDays/$(request.resource.data.facilityId + '__' + request.resource.data.date))
                    && scheduleDayAfter(request.resource.data.facilityId, request.resource.data.date).data.lastBookingId == bookingId;

      allow update: if existsAfter(/databases/$(database)/documents/availability/$(bookingId))
                    && availabilityAfter(bookingId).data.facilityId == request.resource.data.facilityId
                    && availabilityAfter(bookingId).data.date == request.resource.data.date
                    && availabilityAfter(bookingId).data.startTime == request.resource.data.startTime
                    && availabilityAfter(bookingId).data.endTime == request.resource.data.endTime
                    && availabilityAfter(bookingId).data.status == request.resource.data.status
                    && (isFacilityAdmin(resource.data.facilityId)
                        || (isSignedIn()
                            && resource.data.userId == request.auth.uid
                            && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['status', 'completedAt'])
                            && request.resource.data.status in ['cancelled', 'completed']));
      allow delete: if isFacilityAdmin(resource.data.facilityId)
                    && !existsAfter(/databases/$(database)/documents/availability/$(bookingId));
    }

    // Only facility, date, time, and status are public to signed-in users.
    match /availability/{bookingId} {
      allow read: if isSignedIn();
      allow create, update: if isFacilityAdmin(request.resource.data.facilityId)
                    || (isSignedIn()
                        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId))
                        && bookingAfter(bookingId).data.userId == request.auth.uid
                        && bookingAfter(bookingId).data.facilityId == request.resource.data.facilityId
                        && bookingAfter(bookingId).data.date == request.resource.data.date
                        && bookingAfter(bookingId).data.startTime == request.resource.data.startTime
                        && bookingAfter(bookingId).data.endTime == request.resource.data.endTime
                        && bookingAfter(bookingId).data.status == request.resource.data.status);
      allow delete: if isFacilityAdmin(resource.data.facilityId)
                    && !existsAfter(/databases/$(database)/documents/bookings/$(bookingId));
    }

    // The day revision serializes same-day reservation transactions.
    match /scheduleDays/{dayId} {
      allow read: if isSignedIn();
      allow create, update: if isFacilityAdmin(request.resource.data.facilityId)
                    || (isSignedIn()
                        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBookingId))
                        && bookingAfter(request.resource.data.lastBookingId).data.userId == request.auth.uid
                        && bookingAfter(request.resource.data.lastBookingId).data.facilityId == request.resource.data.facilityId
                        && bookingAfter(request.resource.data.lastBookingId).data.date == request.resource.data.date);
      allow delete: if isFacilityAdmin(resource.data.facilityId);
    }

    match /idPhotos/{photoId} {
      allow read: if isSelf(resource.data.ownerId)
        || isSuperAdmin()
        || (isAdmin()
            && resource.data.get('facilityIds', []).hasAny(
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedFacilityIds', [])
            ));
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.facilityIds is list
                    && request.resource.data.size <= 700 * 1024
                    && request.resource.data.contentType.matches('image/(jpeg|png|webp)');
      allow update: if (isSelf(resource.data.ownerId) || isSuperAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['facilityIds'])
        && request.resource.data.get('facilityIds', []).hasAll(resource.data.get('facilityIds', []));
      allow delete: if isSelf(resource.data.ownerId) || isSuperAdmin();
    }

    match /blockedSlots/{slotId} {
      allow read: if isSignedIn();
      allow create, update: if isFacilityAdmin(request.resource.data.facilityId);
      allow delete: if isFacilityAdmin(resource.data.facilityId);
    }

    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.uid);
      allow update: if isSelf(resource.data.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSelf(resource.data.uid);
      allow create: if isAdmin()
                    && request.resource.data.uid is string
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.read == false
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.uid));
    }

    match /bookingAudit/{auditId} {
      allow read: if isFacilityAdmin(resource.data.facilityId);
      allow create: if isFacilityAdmin(request.resource.data.facilityId)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.date is string
        && request.resource.data.action is string
        && request.resource.data.keys().hasOnly([
          'bookingId', 'facilityId', 'date', 'startTime', 'endTime',
          'studentName', 'action', 'actorUid', 'actorName',
          'previousStatus', 'status', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /requestAlerts/{bookingId} {
      allow read: if isFacilityAdmin(resource.data.facilityId);
      allow create: if isSignedIn()
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId))
        && bookingAfter(bookingId).data.userId == request.auth.uid
        && bookingAfter(bookingId).data.status == 'pending'
        && request.resource.data.bookingId == bookingId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.facilityId == bookingAfter(bookingId).data.facilityId
        && request.resource.data.date == bookingAfter(bookingId).data.date
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['bookingId', 'userId', 'facilityId', 'date', 'read', 'createdAt']);
      allow update: if isFacilityAdmin(resource.data.facilityId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }
  }
}
