rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ────────────────────────────────────────────────
    // An account may only ever be created as a student, and a student may only
    // ever change their own name/phone. The role field is immutable to
    // everyone except an existing admin — otherwise anyone could register with
    // an "admin" email address and approve their own bookings.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid) && request.resource.data.role == 'student';

      allow update: if isAdmin()
                    || (isSelf(uid)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['fullName', 'phone']));

      allow delete: if isAdmin();
    }

    // ── Bookings ─────────────────────────────────────────────
    // Students create their own pending requests; admins manage the rest.
    match /bookings/{bookingId} {
      allow read: if isSignedIn();

      // `startAt` is the same window as `startTime` expressed as an instant,
      // which makes "no booking in the past" enforceable here rather than only
      // in the form — the UI check is only a convenience.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.startAt is timestamp
                    && request.resource.data.startAt > request.time;

      // A student may only close out their own booking, or cancel it. Anything
      // that matters for approval — the reviewer, the window, the venue — is
      // admin-only, as is declaring a no-show.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'completedAt'])
                        && request.resource.data.status in ['cancelled', 'completed']);

      allow delete: if isAdmin();
    }

    // ── School ID photos ────────────────────────────────────
    // Stored as bytes in Firestore rather than Cloud Storage, which needs the
    // Blaze billing plan. The 1 MiB document limit is enforced here too.
    match /idPhotos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.size <= 700 * 1024
                    && request.resource.data.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ── Schedule closures ────────────────────────────────────
    // Admin-maintained. Everyone signed in can read the calendar.
    match /blockedSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Recipients may only flip their own `read` flag.
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isSelf(resource.data.uid);

      // Only trusted server-side code (the Admin SDK or a Cloud Function)
      // should write notifications.
      allow create: if false;
    }
  }
}