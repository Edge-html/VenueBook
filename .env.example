# Firebase web app config.
# These ship to the browser either way — they are not secrets.
# The values below are the defaults already baked into src/lib/firebase.ts,
# so the app runs without this file. Override them on Vercel if you use a
# different Firebase project.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAhzRNxu9CnlzAbPnC9BiX3d2yDVUV6GyU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=simple-note-app-e9e59.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=simple-note-app-e9e59
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=simple-note-app-e9e59.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=135416078600
NEXT_PUBLIC_FIREBASE_APP_ID=1:135416078600:web:7dd249ba5a22f48d58ccbd
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-KGQ28LX5H5

# Server-only email OTP configuration. Set these in Vercel project settings.
# FIREBASE_SERVICE_ACCOUNT_JSON is the complete service-account JSON on one line.
# OTP_HASH_SECRET should be at least 32 random bytes (for example, 64 hex characters).
FIREBASE_SERVICE_ACCOUNT_JSON=
OTP_HASH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# There is deliberately no "admin emails" variable.
# Admin rights are granted in the Firebase console (users/{uid} -> role: admin),
# because any list shipped to the browser could be abused to self-promote.
